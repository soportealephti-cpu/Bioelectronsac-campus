# Configuración de producción (Docker)
# Este archivo define las variables de entorno para el entorno de producción

# MongoDB Connection
MONGO_URI=mongodb://mongodb:27017/bioelectronCursosDB

# Server
PORT=5000
JWT_SECRET=your-secret-key-here

# Environment
NODE_ENV=production

# API URL - Usar HTTPS en producción
API_URL=https://api.campus.bioelectronsac.com
